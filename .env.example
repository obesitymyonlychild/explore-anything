# Copy to .env and fill in.
ANTHROPIC_API_KEY=

DATABASE_URL=postgresql+asyncpg://explore:explore@localhost:5433/explore
TEST_DATABASE_URL=postgresql+asyncpg://explore:explore@localhost:5433/explore_test

# LLM settings (used from M2)
CHAT_MODEL=claude-opus-5-5
CHAT_EFFORT=low
LIGHT_MODEL=claude-haiku-5-5
TRANSLATE_CARDS=true   # Simplified Chinese for every card (~$0.0007 each)

# Spend limits in USD for the app's own API calls (0 = no limit). Turns and Surprise me are refused
# once one is reached. Evals have their own guard: run_cards.py --max-cost.
DAILY_BUDGET_USD=2
MONTHLY_BUDGET_USD=20
